# Production builds: NODE_ENV must be "production" (Hostinger build script enforces this if unset).
NODE_ENV=production

# SSG worker count during `next build` (default 1 — reduces Neon connection churn)
# STATIC_GENERATION_CPUS=1
# Per-worker pool size during build (default 2 → ~2 connections with 1 CPU worker)
# BUILD_DATABASE_CONNECTION_LIMIT=2
# Max seconds per static page during build (default 180)
# STATIC_PAGE_GENERATION_TIMEOUT=180

# Neon pooler (-pooler host). prisma.ts adds pgbouncer=true & connection_limit at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Non-pooler host — migrations only (npm run db:migrate)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Production runtime only (ignored in local dev). Default 1 conn/process on Hostinger.
# DATABASE_CONNECTION_LIMIT=1

# Performance observability (structured JSON logs, channel "perf")
# PERF_LOG=1
# PERF_SAMPLE_RATE=0.05
# PERF_SLOW_ROUTE_MS=1500
# PERF_SLOW_PRISMA_MS=250
# SHOP_LISTING_PROFILE=1

# Google Tag Manager (optional — loads after page idle; set GA4 tag inside GTM)
# Create container at https://tagmanager.google.com → copy Container ID (GTM-XXXXXXX)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# GA4 Analytics Dashboard (/analytics) — server-side Data API (see ANALYTICS_SETUP.md)
# GA4_PROPERTY_ID=123456789
# GA4_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ShipMozo shipping (required for orders to appear in ShipMozo after payment)
# SHIPMOZO_PUBLIC_KEY=
# SHIPMOZO_PRIVATE_KEY=
# SHIPMOZO_WAREHOUSE_ID=
# SHIPMOZO_WAREHOUSE_TITLE=Main Warehouse
# SHIPMOZO_DEFAULT_HSN=95030090
# SHIPMOZO_DEFAULT_GST_PERCENT=18
# SHIPMOZO_PUSH_LOOKBACK_DAYS=60
# SHIPMOZO_PUSH_BATCH_SIZE=25

# ShipMozo webhook (optional — ShipMozo API docs use polling, not webhooks)
SHIPMOZO_WEBHOOK_SECRET=your_secret_here

# ShipMozo tracking sync (no host cron needed — runs while Node is up, like abandoned-cart)
# SHIPMOZO_TRACKING_SCHEDULER_ENABLED=0
# SHIPMOZO_TRACKING_INTERVAL_MINUTES=30
# SHIPMOZO_TRACKING_BATCH_SIZE=40
# SHIPMOZO_TRACKING_LOOKBACK_DAYS=45
