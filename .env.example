# Production builds: NODE_ENV must be "production" (Hostinger build script enforces this if unset).
NODE_ENV=production

# Use Neon *pooler* host (-pooler in hostname) in production. src/lib/prisma.ts caps connections (default 2 in prod).
# Optional: DATABASE_CONNECTION_LIMIT=2
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15

# Performance observability (structured JSON logs, channel "perf")
# PERF_LOG=1
# PERF_SAMPLE_RATE=0.05
# PERF_SLOW_ROUTE_MS=1500
# PERF_SLOW_PRISMA_MS=250
# SHOP_LISTING_PROFILE=1
