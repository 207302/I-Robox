# Production builds: NODE_ENV must be "production" (Hostinger build script enforces this if unset).
NODE_ENV=production

# SSG worker count during `next build` (default 1 — reduces Neon connection churn)
# STATIC_GENERATION_CPUS=1
# Per-worker pool size during build (default 2 → ~2 connections with 1 CPU worker)
# BUILD_DATABASE_CONNECTION_LIMIT=2
# Max seconds per static page during build (default 180)
# STATIC_PAGE_GENERATION_TIMEOUT=180

# Neon pooler (-pooler host). prisma.ts adds pgbouncer=true & connection_limit at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Non-pooler host — migrations only (npm run db:migrate)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Production runtime only (ignored in local dev). Default 1 conn/process on Hostinger.
# DATABASE_CONNECTION_LIMIT=1

# Performance observability (structured JSON logs, channel "perf")
# PERF_LOG=1
# PERF_SAMPLE_RATE=0.05
# PERF_SLOW_ROUTE_MS=1500
# PERF_SLOW_PRISMA_MS=250
# SHOP_LISTING_PROFILE=1

# Google Tag Manager (optional — loads after page idle; set GA4 tag inside GTM)
# Create container at https://tagmanager.google.com → copy Container ID (GTM-XXXXXXX)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# GA4 Analytics Dashboard (/analytics) — server-side Data API (see ANALYTICS_SETUP.md)
# GA4_PROPERTY_ID=123456789
# Option A — separate fields (private key must stay on ONE line with \n escapes):
# GA4_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Option B — paste the full service account JSON (easiest on Hostinger):
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  (one line; Hostinger breaks multi-line values)
# GA4_SERVICE_ACCOUNT_JSON_BASE64=...  (base64 of the JSON file; most reliable on Hostinger)

# Google reCAPTCHA v2 (login + signup) — https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
# RECAPTCHA_SECRET_KEY=your_secret_key

# ShipMozo shipping (required for orders to appear in ShipMozo after payment)
# SHIPMOZO_PUBLIC_KEY=
# SHIPMOZO_PRIVATE_KEY=
# SHIPMOZO_WAREHOUSE_ID=
# SHIPMOZO_WAREHOUSE_TITLE=Main Warehouse
# SHIPMOZO_DEFAULT_HSN=95030090
# SHIPMOZO_DEFAULT_GST_PERCENT=18
# SHIPMOZO_PUSH_LOOKBACK_DAYS=60
# SHIPMOZO_PUSH_BATCH_SIZE=25

# Razorpay payments (checkout + refund webhooks)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Account & Settings → Webhooks.
# Must exactly match the secret shown when you create/edit the webhook endpoint.
# Required for refund.processed / refund.created events at POST /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ShipMozo webhook (optional — ShipMozo API docs use polling, not webhooks)
SHIPMOZO_WEBHOOK_SECRET=your_secret_here

# Order / transactional email (Nodemailer SMTP — required for order confirmation emails)
#
# Production (Hostinger): hPanel → Websites → Node.js → [your app] → Environment variables.
# Do NOT rely on .env files on the server — set each variable in hPanel, then redeploy/restart.
#
# Recommended: Hostinger mailbox for orders (unsuspend info@i-robox.com in hPanel → Emails first).
# Password: hPanel → Emails → info@i-robox.com → lock icon → set/reset password.
# SMTP details: hPanel → Emails → Manage → Connect Apps & Devices.
#
# EMAIL_SERVER_HOST=smtp.hostinger.com
# EMAIL_SERVER_PORT=465
# EMAIL_SERVER_USER=info@i-robox.com
# EMAIL_SERVER_PASSWORD=your_mailbox_password
# EMAIL_FROM=i-Robox <info@i-robox.com>
#
# After deploy, SSH into Hostinger (or use their terminal) and verify:
#   node scripts/test-order-email.mjs your-test@gmail.com
# Expect: [test-order-email] sent and [sendEmail] sent in app logs after a real order.
#
# Do NOT use this mailbox for admin "Send bulk email" (marketing) — use Gmail or Brevo/Resend instead.
#
# Alternative: Gmail SMTP (Google App Password for iroboxtoys@gmail.com):
# EMAIL_SERVER_HOST=smtp.gmail.com
# EMAIL_SERVER_PORT=465
# EMAIL_SERVER_USER=iroboxtoys@gmail.com
# EMAIL_SERVER_PASSWORD=your_16_char_gmail_app_password
# EMAIL_FROM=i-Robox <iroboxtoys@gmail.com>
EMAIL_SERVER_HOST=smtp.hostinger.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=info@i-robox.com
EMAIL_SERVER_PASSWORD=your_mailbox_password
EMAIL_FROM=i-Robox <info@i-robox.com>

# ShipMozo tracking sync (no host cron needed — runs while Node is up, like abandoned-cart)
# SHIPMOZO_TRACKING_SCHEDULER_ENABLED=0
# SHIPMOZO_TRACKING_INTERVAL_MINUTES=30
# SHIPMOZO_TRACKING_BATCH_SIZE=40
# SHIPMOZO_TRACKING_LOOKBACK_DAYS=45
