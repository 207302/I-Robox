# Hostinger hPanel → Websites → Manage → Node.js → Environment variables
# Add each variable below. Append pool params if your DATABASE_URL omits them.

NODE_ENV=production
PORT=3000

# Neon / PostgreSQL (pooler URL recommended for runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connection_limit=15&pool_timeout=30&connect_timeout=15

# Direct URL for migrations (non-pooler host)
DIRECT_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15
