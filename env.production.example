# Hostinger hPanel → Websites → Manage → Node.js → Environment variables

NODE_ENV=production
PORT=3000

# Neon — pooled URL for the app (must include -pooler in hostname)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct URL for migrations only (non-pooler host)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Runtime: 1 connection per Node process (Hostinger). Dev ignores this.
DATABASE_CONNECTION_LIMIT=1

# Optional build tuning (set in Hostinger build env if builds still timeout)
# BUILD_DATABASE_CONNECTION_LIMIT=2
# STATIC_GENERATION_CPUS=1
# STATIC_PAGE_GENERATION_TIMEOUT=180
