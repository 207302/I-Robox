# Hostinger hPanel → Websites → Manage → Node.js → Environment variables
# Add each variable below. Append pool params if your DATABASE_URL omits them.

NODE_ENV=production

# PDPs pre-rendered at build (best sellers + highlights + flash + recent). 0 = skip. Max 50.
STATIC_PDP_BUILD_LIMIT=40
PORT=3000

# Neon pooler host (-pooler in hostname). src/lib/prisma.ts sets connection_limit at runtime
# (default 1 per Node process on Hostinger). Override only if you sized workers × limit to Neon plan.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_CONNECTION_LIMIT=1

# Direct URL for migrations (non-pooler host)
DIRECT_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15
